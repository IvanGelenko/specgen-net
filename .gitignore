[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# Test runner output
TestResults/

# ReSharper
_ReSharper*/

# NuGet
packages/
*.nupkg

# Build artifacts shipped to users (regenerated by build.cmd)
bundle_staged/
bundle_navis_staged/
dist_navis/
dist_installer/
dist/
artifacts/
specgen-backup-*/

# Local tool settings of other assistants
.codex/

# Local secrets (tokens for MCP servers etc.) — never committed
.env
.env.*
!.env.example

# GitHub Actions runner package (tools/setup-runner.ps1 installs it to C:\actions-runner)
actions-runner/

# Windows
Thumbs.db
desktop.ini

# Editor backups
*.bak
*.orig
*.stamped
*.swp

# Sample / dev artifacts that occasionally land in the repo root.
# The user keeps a working Plant 3D project + template here while
# iterating; these are user data, not source.
test project/
*.docx
# …except the embedded audit report template: the plug-in does not build
# without it (EmbeddedResource in PipingSpecPlugin.csproj).
!src/PipingSpecPlugin/Resources/AuditReportTemplate.docx
.claude/scheduled_tasks.lock
