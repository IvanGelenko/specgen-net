<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage SchemaVersion="1.0"
                    AutodeskProduct="AutoCAD"
                    ProductType="Application"
                    Name="PipingSpecPlugin"
                    AppVersion="__APPVERSION__"
                    Description="Piping spec generator for Plant 3D"
                    Author="In-house"
                    ProductCode="{B5E20C42-5C4D-4F1B-9B7C-1D5E2B0A8C03}"
                    UpgradeCode="{B5E20C42-5C4D-4F1B-9B7C-1D5E2B0A8C04}">

  <CompanyDetails Name="In-house" Email="" Phone="" Url=""/>

  <Components>
    <!-- SeriesMin R25.0 = AutoCAD / Plant 3D 2025. The DLL is compiled against
         the 2025 managed wrappers (25.0.0.0, PnP 16.0), which 2026 (R25.1)
         also satisfies with its newer assemblies. Never compile against 2026
         while this says R25.0: .NET cannot bind a 25.1 reference to 2025's
         25.0 and the plug-in would fail at every 2025 start. -->
    <RuntimeRequirements OS="Win64"
                         Platform="AutoCAD*"
                         SeriesMin="R25.0"
                         SeriesMax="R30.0"
                         SupportPath="./Contents/Windows/"/>
    <ComponentEntry AppName="PipingSpecPlugin"
                    ModuleName="./Contents/Windows/PipingSpecPlugin.dll"
                    AppDescription="Piping specification generator"
                    LoadOnAutoCADStartup="True"
                    PerDocument="True"/>
  </Components>
</ApplicationPackage>
