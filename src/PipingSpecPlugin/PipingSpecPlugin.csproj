<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- AutoCAD 2026 ships .NET 8 managed wrappers (AcCoreMgd Version=25.1.0.0
         references System.Runtime 8.0.0.0). Match it exactly: anything older
         fails at load with CS1705 / FileLoadException at runtime. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <RootNamespace>PipingSpecPlugin</RootNamespace>
    <AssemblyName>PipingSpecPlugin</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- net8.0-windows already means Windows-only; silence the platform
         compatibility analyzer for WinForms / WPF call sites. -->
    <NoWarn>CA1416</NoWarn>
    <!-- NuGet packages we depend on (DocumentFormat.OpenXml etc.) MUST be
         copied to the output folder so AutoCAD can resolve them at load
         time. AutoCAD's own DLLs are individually marked Private=False
         below so they aren't duplicated next to ours. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Default plug-in version. build.cmd / CI override with -p:Version=X.Y.Z
         (from the VERSION file or the git tag). The AssemblyVersion /
         FileVersion attributes are generated from this below — they are NOT
         hard-coded in AssemblyInfo.cs, so the override actually takes effect
         and the in-plugin update check reads the right version. -->
    <Version Condition=" '$(Version)' == '' ">1.1.6</Version>
  </PropertyGroup>

  <!-- Emit AssemblyVersion / AssemblyFileVersion from $(Version) into a
       generated source file. We can't rely on the SDK's normal attribute
       generation because GenerateAssemblyInfo=false (the manual
       AssemblyInfo.cs carries AutoCAD's CommandClass / ExtensionApplication
       attributes). This target fills only the version gap. -->
  <Target Name="GenerateVersionInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_VersionFourPart>$(Version).0</_VersionFourPart>
      <_GenVersionFile>$(IntermediateOutputPath)VersionInfo.g.cs</_GenVersionFile>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>$(_VersionFourPart)</_Parameter1>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(_VersionFourPart)</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>
    <WriteCodeFragment AssemblyAttributes="@(AssemblyAttribute)"
                       Language="C#"
                       OutputFile="$(_GenVersionFile)">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
    </WriteCodeFragment>
  </Target>

  <!-- Override with: msbuild /p:AcadInstallDir="D:\Autodesk\AutoCAD 2026" -->
  <PropertyGroup>
    <AcadInstallDir Condition=" '$(AcadInstallDir)' == '' ">C:\Program Files\Autodesk\AutoCAD 2026</AcadInstallDir>
    <Plnt3DDir>$(AcadInstallDir)\PLNT3D</Plnt3DDir>
    <!-- PnPDataLinks / PnPDataObjects live directly under the AutoCAD root,
         NOT under PLNT3D. Don't conflate them when adding new references. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Core AutoCAD managed API. Private=False so the DLLs aren't copied
         into our output: AutoCAD already loads its own copy. -->
    <Reference Include="AcCoreMgd">
      <HintPath>$(AcadInstallDir)\AcCoreMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AcadInstallDir)\AcDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AcadInstallDir)\AcMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AcadInstallDir)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Plant 3D managed APIs. PnP.dll is native ARX (no metadata), do not
         reference it. The *Mgd suffix denotes managed wrappers.
         PnPProjectManagerMgd hosts Autodesk.ProcessPower.PlantInstance.PlantApplication
         (the singleton-style host with the static CurrentProject accessor) and
         Autodesk.ProcessPower.ProjectManager.PlantProject. -->
    <Reference Include="PnP3dMain">
      <HintPath>$(Plnt3DDir)\PnP3dMain.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PnP3dProjectPartsMgd">
      <HintPath>$(Plnt3DDir)\PnP3dProjectPartsMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PnP3dObjectsMgd">
      <HintPath>$(Plnt3DDir)\PnP3dObjectsMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PnPProjectManagerMgd">
      <HintPath>$(Plnt3DDir)\PnPProjectManagerMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PnPDataLinks">
      <HintPath>$(AcadInstallDir)\PnPDataLinks.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PnPDataObjects">
      <HintPath>$(AcadInstallDir)\PnPDataObjects.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Word output. Stay on the 2.x line: OpenXml 3.x dropped legacy
         APIs and we don't need its new SDK-style features yet. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.20.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ribbon icons. EmbeddedResource keeps them inside the DLL so
         there's nothing extra to ship next to it; PluginBootstrap
         loads them through GetManifestResourceStream. -->
    <EmbeddedResource Include="Resources\icon16.png" />
    <EmbeddedResource Include="Resources\icon32.png" />
  </ItemGroup>

</Project>
