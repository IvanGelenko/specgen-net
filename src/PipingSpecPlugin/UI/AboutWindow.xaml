<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipingSpecPlugin.UI.AboutWindow"
        Title="О программе"
        Height="420" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="ProductText"
                   FontSize="18" FontWeight="Bold"
                   Text="Генератор спецификации Plant 3D" />

        <TextBlock Grid.Row="1" x:Name="VersionText" Margin="0,6,0,0"
                   Foreground="#444" Text="Версия 0.0.0" />

        <TextBlock Grid.Row="2" x:Name="DescriptionText" Margin="0,4,0,0"
                   Foreground="#444" TextWrapping="Wrap"
                   Text="Плагин для AutoCAD Plant 3D." />

        <Border Grid.Row="3" Margin="0,14,0,0" BorderBrush="#DDD"
                BorderThickness="1" Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <TextBlock x:Name="FeaturesText" TextWrapping="Wrap"
                           Foreground="#333" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Foreground="#444" Text="Репозиторий: " VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center">
                <Hyperlink x:Name="RepoLink" Click="RepoLink_Click">
                    <Run x:Name="RepoText" Text="github.com/IvanGelenko/specgen-net" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" x:Name="CloseButton"
                    Content="Закрыть" Width="100" IsDefault="True" IsCancel="True"
                    Click="CloseButton_Click" />
            <Button DockPanel.Dock="Left" x:Name="CheckUpdatesButton"
                    Content="Проверить обновления" Width="180"
                    Click="CheckUpdatesButton_Click" />
        </DockPanel>
    </Grid>
</Window>
