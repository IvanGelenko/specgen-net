<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipingSpecPlugin.UI.ProgressWindow"
        Title="Сканирование проекта"
        Height="180" Width="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" FontWeight="Bold"
                   Text="Сканирование проекта Plant 3D…" />

        <TextBlock Grid.Row="1" x:Name="DetailText" Margin="0,8,0,0"
                   Foreground="#444" TextTrimming="CharacterEllipsis"
                   Text="Подготовка…" />

        <ProgressBar Grid.Row="2" x:Name="Bar"
                     Height="22" Margin="0,16,0,0"
                     Minimum="0" Maximum="100" Value="0" />

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right"
                    x:Name="CancelButton"
                    Content="Отмена" Width="90"
                    Click="CancelButton_Click" />
            <TextBlock x:Name="CounterText" VerticalAlignment="Center"
                       Foreground="Gray" FontStyle="Italic" />
        </DockPanel>
    </Grid>
</Window>
