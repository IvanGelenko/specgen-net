<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipingSpecPlugin.UI.SyncVtWindow"
        Title="Синхронизация с Ведомостью трубопроводов"
        Height="760" Width="1400"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- file picker -->
            <RowDefinition Height="Auto" /> <!-- summary -->
            <RowDefinition Height="*" />    <!-- internal ledger -->
            <RowDefinition Height="Auto" /> <!-- problems -->
            <RowDefinition Height="Auto" /> <!-- bottom bar -->
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Файл Ведомости трубопроводов (.xlsx)" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="BrowseButton"
                        Content="Обзор..." Width="80" Margin="8,0,0,0"
                        Click="BrowseButton_Click"/>
                <Button DockPanel.Dock="Right" x:Name="LoadButton"
                        Content="Загрузить" Width="90" Margin="8,0,0,0"
                        Click="LoadButton_Click"/>
                <TextBox x:Name="VtPathBox" VerticalContentAlignment="Center" TextChanged="VtPathBox_TextChanged"/>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Сводка" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Text="Файл не загружен."/>
        </GroupBox>

        <GroupBox Grid.Row="2" Padding="6" Margin="0,0,0,10">
            <GroupBox.Header>
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" x:Name="LedgerScopeBox" MinWidth="155" Margin="12,0,0,0"
                              SelectionChanged="LedgerScope_Changed"
                              AutomationProperties.Name="Область ведомости">
                        <ComboBoxItem x:Name="CurrentDrawingScopeItem" Content="Текущий чертёж"
                                      ToolTipService.ShowOnDisabled="True"/>
                        <ComboBoxItem x:Name="ProjectScopeItem" Content="Весь проект"/>
                    </ComboBox>
                    <TextBlock Text="Внутренняя ведомость трубопроводов"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </GroupBox.Header>
            <DataGrid x:Name="LedgerGrid" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="All" HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      FontSize="11" MinRowHeight="22"
                      ColumnHeaderHeight="220"
                      SelectionUnit="FullRow"
                      SelectionMode="Single"
                      SelectionChanged="LedgerGrid_SelectionChanged"
                      PreviewMouseRightButtonDown="LedgerGrid_PreviewMouseRightButtonDown">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="SyncSelectedMenuItem"
                                  Header="Синхронизировать выделенную линию"
                                  Click="ApplySelectedButton_Click"
                                  IsEnabled="False"/>
                        <MenuItem x:Name="DeleteDuplicateMenuItem"
                                  Header="Удалить выбранный дубль из проекта"
                                  Click="DeleteDuplicateMenuItem_Click"
                                  ToolTip="Выберите строку с повторяющимся ID."
                                  ToolTipService.ShowOnDisabled="True"
                                  IsEnabled="False"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Проблемы (не будут записаны)" Padding="6" Margin="0,0,0,10" MaxHeight="160">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ProblemsText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
            </ScrollViewer>
        </GroupBox>

        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Right" x:Name="CloseButton"
                    Content="Закрыть" Width="100" Height="32" Margin="8,0,0,0"
                    Click="CloseButton_Click"/>
            <Button DockPanel.Dock="Right" x:Name="ApplyButton"
                    Content="Применить все в Plant 3D" Width="205" Height="32" Margin="8,0,0,0"
                    Click="ApplyButton_Click" IsEnabled="False"/>
            <Button DockPanel.Dock="Right" x:Name="ApplySelectedButton"
                    Content="Применить выделенную" Width="195" Height="32" Margin="8,0,0,0"
                    Click="ApplySelectedButton_Click" IsEnabled="False"/>
            <Button DockPanel.Dock="Right" x:Name="RefreshButton"
                    Content="Обновить ведомость" Width="180" Height="32" Margin="0,0,8,0"
                    Click="RefreshButton_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="Gray" FontStyle="Italic" Text="Выберите файл ВТ и нажмите «Загрузить»."/>
        </DockPanel>
    </Grid>
</Window>
