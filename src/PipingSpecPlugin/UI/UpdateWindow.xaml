<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipingSpecPlugin.UI.UpdateWindow"
        Title="Доступно обновление"
        Height="360" Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="Bold" FontSize="15"
                   Text="Доступна новая версия плагина" />

        <TextBlock Grid.Row="1" x:Name="VersionText" Margin="0,8,0,0"
                   Foreground="#444" />

        <Border Grid.Row="2" Margin="0,12,0,0" BorderBrush="#DDD"
                BorderThickness="1" Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                           Foreground="#333" />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,10,0,0"
                   Foreground="Gray" FontStyle="Italic" />

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" x:Name="LaterButton"
                    Content="Позже" Width="90" Margin="8,0,0,0"
                    Click="LaterButton_Click" />
            <Button DockPanel.Dock="Right" x:Name="UpdateButton"
                    Content="Обновить" Width="120" Margin="8,0,0,0"
                    FontWeight="Bold" Click="UpdateButton_Click" />
            <Button DockPanel.Dock="Left" x:Name="ReleasePageButton"
                    Content="Страница релиза" Width="140"
                    Click="ReleasePageButton_Click" />
        </DockPanel>
    </Grid>
</Window>
