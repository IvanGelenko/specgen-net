<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The plug-in itself references AcMgd / AcDbMgd / PnP*Mgd, none of
         which are CLR-loadable outside the AutoCAD process. To keep
         tests runnable on any dev box, pull only the pure-logic Spec/
         files into this project by source rather than referencing the
         plug-in DLL. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\PipingSpecPlugin\Audit\AuditDocxReport.cs" Link="Audit\AuditDocxReport.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Audit\InsulationJointPolicy.cs" Link="Audit\InsulationJointPolicy.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Audit\SupportContactPolicy.cs" Link="Audit\SupportContactPolicy.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Audit\ConnectedJointPolicy.cs" Link="Audit\ConnectedJointPolicy.cs" />
    <EmbeddedResource Include="..\..\src\PipingSpecPlugin\Resources\AuditReportTemplate.docx" LogicalName="PipingSpecPlugin.AuditReportTemplate.docx" />
    <Compile Include="..\..\src\PipingSpecPlugin\Audit\AuditModels.cs" Link="Audit\AuditModels.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Layers\LayerColorPlanner.cs" Link="Layers\LayerColorPlanner.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Audit\AuditRules.cs" Link="Audit\AuditRules.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Audit\AuditReport.cs" Link="Audit\AuditReport.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\PartPropertyReader.cs" Link="Spec\PartPropertyReader.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\SpecNumber.cs" Link="Spec\SpecNumber.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\LengthUnits.cs" Link="Spec\LengthUnits.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\DrawingPartIds.cs" Link="Spec\DrawingPartIds.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\LineSyncPlanner.cs" Link="Spec\LineSyncPlanner.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\LineSyncModels.cs" Link="Spec\LineSyncModels.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\SyncTransaction.cs" Link="Spec\SyncTransaction.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\SpecTemplateWriter.cs" Link="Spec\SpecTemplateWriter.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\XmlText.cs" Link="Spec\XmlText.cs" />

    <Compile Include="..\..\src\PipingSpecPlugin\Spec\PartRecord.cs" Link="Spec\PartRecord.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\SpecRow.cs" Link="Spec\SpecRow.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\SpecConstants.cs" Link="Spec\SpecConstants.cs" />
