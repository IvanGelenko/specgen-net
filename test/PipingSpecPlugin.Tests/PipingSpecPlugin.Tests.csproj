    <Compile Include="..\..\src\PipingSpecPlugin\Spec\ReviewSection.cs" Link="Spec\ReviewSection.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\ProjectFacts.cs" Link="Spec\ProjectFacts.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\ValveCompanionFinder.cs" Link="Spec\ValveCompanionFinder.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\ScanCache.cs" Link="Spec\ScanCache.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\PipeBendFolder.cs" Link="Spec\PipeBendFolder.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\BendNameNormalizer.cs" Link="Spec\BendNameNormalizer.cs" />
    <Compile Include="..\..\src\PipingSpecPlugin\Spec\InsulationTakeoff.cs" Link="Spec\InsulationTakeoff.cs" />
