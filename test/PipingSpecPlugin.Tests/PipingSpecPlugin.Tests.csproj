    <Compile Include="..\..\src\PipingSpecPlugin\Layers\TagLayerMover.cs" Link="Layers\TagLayerMover.cs" />
    <!-- VtReader/VtRowData depend only on DocumentFormat.OpenXml, not on
         any Autodesk assembly, so they're testable the same way as the
         rest of Spec/. LineSyncService itself references
         Autodesk.ProcessPower.DataLinks (DataLinksManager) and can't be
         loaded outside the AutoCAD process — same constraint as
         PartReader, which also has no test coverage here. -->
