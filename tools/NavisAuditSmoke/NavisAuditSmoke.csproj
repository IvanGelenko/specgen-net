<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the NavisAudit JSON plug-in in a hidden Navisworks (Automation
       API): NavisAuditSmoke <model.nwd|nwc> <NavisAudit.dll or - for the installed bundle> <out.json> [key=value…]
       Build with -p:NavisYear=2025 for another release. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <NavisYear Condition=" '$(NavisYear)' == '' ">2026</NavisYear>
    <NavisDir>C:\Program Files\Autodesk\Navisworks Manage $(NavisYear)</NavisDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Autodesk.Navisworks.Automation"><HintPath>$(NavisDir)\Autodesk.Navisworks.Automation.dll</HintPath><Private>True</Private></Reference>
  </ItemGroup>
</Project>
